def update():
    global score
    if keyboard.left:
      bee.x=bee.x-3
    if keyboard.right:
      bee.x=bee.x+3
    #thay need to work together so sets of if
    if keyboard.down:
      bee.y=bee.y+3
    if keyboard.up:
      bee.y=bee.y-3
    if bee.colliderect(flower):
       flower.x=random.randint(20,WIDTH-20)
       flower.y=random.randint(20,HEIGHT-20)
       score=score+10

def timeup():
  global gameover
  gameover=True
    
clock.schedule(timeup,20)       
   

pgzrun.go()
