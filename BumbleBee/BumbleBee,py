import pgzrun
import random
WIDTH=600
HEIGHT=500
TITLE="Bumble Bee and Flower"

score=0

bee=Actor("bee")
bee.x=random.randint(20,WIDTH-20)
bee.y=random.randint(20,HEIGHT-20)

flower=Actor("flower")
flower.x=random.randint(20,WIDTH-20)
flower.y=random.randint(20,HEIGHT-20)

def draw():
   screen.blit("background",(0,0))
   screen.draw.text(f"Score={score}",(10,10))
   bee.draw()
   flower.draw()

# this function only works when pressing key, you cant hold it down
# def on_key_down(key):
#    print(key)
#    if key==keys.LEFT:
#       bee.x=bee.x-

def update():
    global score
    if keyboard.left:
      bee.x=bee.x-1
    elif keyboard.right:
      bee.x=bee.x+1
    #thay need to work together so sets of if
    if keyboard.down:
      bee.y=bee.y+1
    elif keyboard.up:
      bee.y=bee.y-1
    if bee.colliderect(flower):
       flower.x=random.randint(20,WIDTH-20)
       flower.y=random.randint(20,HEIGHT-20)
       score=score+10
    
       
   

pgzrun.go()
