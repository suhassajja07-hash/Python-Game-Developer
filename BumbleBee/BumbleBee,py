import pgzrun
import random
WIDTH=600
HEIGHT=500
TITLE="Bumble Bee and Flower"

score=0

gameover=False

bee=Actor("bee")
bee.x=random.randint(20,WIDTH-20)
bee.y=random.randint(20,HEIGHT-20)


flower=Actor("flower")
flower.x=random.randint(20,WIDTH-20)
flower.y=random.randint(20,HEIGHT-20)

def draw():
  if not gameover:
    screen.blit("background",(0,0))
    screen.draw.text(f"Score={score}",(10,10))
    bee.draw()
    flower.draw()
  else:
    screen.draw.text(f"Game over your score is {score}",center=(WIDTH/2,HEIGHT/2))
  

