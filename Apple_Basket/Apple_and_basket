import pgzrun
import random
WIDTH = 800
HEIGHT = 600



basket = Actor("basket")
basket.x = 400
basket.y = 550

apple = Actor("apple")
def place_apple():
    apple.x = random.randint(200,WIDTH-200)
    apple.y = 0
place_apple()

score = 0

gameover=False

def draw():
    if not gameover:
        screen.clear()

        basket.draw()
        apple.draw()

        screen.draw.text("Score: " + str(score), (10, 10))
    else:
        screen.draw.text("The game is over",center=(WIDTH/2,HEIGHT/2))

    




def update():
    
    global score

    apple.y = apple.y + 5

    if apple.colliderect(basket):
        score = score + 1
        place_apple()

    
    if apple.y > HEIGHT:
        score = 0
        place_apple()




    # Move left
    if keyboard.left:
        basket.x = basket.x - 5

    # Move right
    if keyboard.right:
        basket.x = basket.x + 5

def timeup():
    global gameover
    gameover=True
clock.schedule(timeup,30)

    





pgzrun.go()